# Variables de entorno
env = TERM=xterm-256color

# Ventana y Dimensiones
window-height = 35
window-width = 125
window-padding-balance = true
window-decoration = true
background-opacity = 1
title = "Ghostty@CachyOS"
window-theme = "dark"

# Historial de Scrollback
scrollback-limit = 10000

# Fuente
font-family = "JetBrains Mono"
font-size = 11.0

# Tema
theme = jetbrains-dark

# Selección y Portapapeles
clipboard-read = allow
clipboard-write = allow

# Cursor
cursor-style = underline
cursor-style-blink = false

# Ratón
mouse-hide-while-typing = true

# Atajos de Teclado (Keybinds)
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+f=start_search
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom
keybind = ctrl+zero=reset_font_size
