GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="$(sed 's, release .*$,,g' /etc/system-release)"
GRUB_DEFAULT=saved
GRUB_DISABLE_SUBMENU=true

#GRUB_TERMINAL_OUTPUT="console"

GRUB_CMDLINE_LINUX="resume=UUID=55a57568-cf39-4519-b628-35b3bc712088 rhgb quiet rd.driver.blacklist=nouveau,nova_core modprobe.blacklist=nouveau,nova_core"
GRUB_DISABLE_RECOVERY="true"
GRUB_ENABLE_BLSCFG=true


GRUB_THEME="/boot/grub2/themes/tachibana/theme.txt"
